#!/usr/bin/env bash

source $(dirname "${0}")/../.env

set -euo pipefail

out_dir="$(mktemp -d)"
filename="$(npm pack --pack-destination "${out_dir}" --silent)"

tarball="${out_dir}/${filename}"

scp "${tarball}" "${DOCKER_HOST}:/tmp/${filename}"
ssh "${DOCKER_HOST}" "\
    docker cp /tmp/${filename} ${DOCKER_CONTAINER}:/homebridge/${filename} && \
    rm /tmp/${filename} && \
    docker exec ${DOCKER_CONTAINER} sh -c \"npm uninstall homebridge-stream-sensors; npm install /homebridge/${filename} && rm /homebridge/${filename}\" && \
    echo \"✅ Installation complete\" \
"
