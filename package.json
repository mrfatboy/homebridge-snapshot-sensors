{
  "name": "homebridge-snapshot-sensors",
  "displayName": "Snapshot Sensors",
  "version": "1.0.1",
  "description": "Homebridge plugin that retrieves camera snapshots and runs on-device YOLO object detection",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": ["dist/", "config.schema.json", "homebridge-ui/", "model/", "native/yolo-runner/bin/", "native/yolo-runner/onnxruntime/", "CHANGELOG.md"],
  "scripts": {
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && node -e \"const fs=require('fs');const path=require('path');const bin=path.join('native','yolo-runner','bin','snapshot-sensors-yolo');const ort=path.join('native','yolo-runner','onnxruntime','libonnxruntime.so');if(!fs.existsSync(bin))throw new Error('Prebuilt YOLO runner is missing: '+bin);if(!fs.existsSync(ort))throw new Error('Prebuilt ONNX Runtime library is missing: '+ort);if(!fs.statSync(bin).isFile())throw new Error('Prebuilt YOLO runner is not a file: '+bin);if(!fs.statSync(ort).isFile())throw new Error('Prebuilt ONNX Runtime library is not a file: '+ort);\" && tsc",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["homebridge-plugin", "homebridge", "homekit", "camera", "snapshot", "object-detection", "yolo", "person-detection", "vehicle-detection", "animal-detection", "smart-home"],
  "repository": {"type": "git", "url": "git+https://github.com/mrfatboy/homebridge-snapshot-sensors.git"},
  "bugs": {"url": "https://github.com/mrfatboy/homebridge-snapshot-sensors/issues"},
  "homepage": "https://github.com/mrfatboy/homebridge-snapshot-sensors#readme",
  "author": {
    "name": "mrfatboy",
    "url": "https://github.com/mrfatboy"
  },
  "license": "AGPL-3.0-only",
  "engines": {"node": ">=20.0.0", "homebridge": "^1.8.0 || ^2.0.0"},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "homebridge": "^2.0.0",
    "prettier": "^3.8.3",
    "typescript": "^5.0.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {"@homebridge/plugin-ui-utils": "^2.2.5"}
}
