{
  "name": "homebridge-snapshot-sensors",
  "displayName": "Snapshot Sensors",
  "version": "1.0.0",
  "description": "Homebridge plugin that retrieves camera snapshots and sends them to YOLO for HomeKit motion detection",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": ["dist/", "config.schema.json", "homebridge-ui/"],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["homebridge-plugin", "homebridge", "homekit", "camera", "snapshot", "object-detection", "yolo", "motion-sensor", "person-detection", "package-detection", "vehicle-detection", "animal-detection", "smart-home"],
  "repository": {"type": "git", "url": "git+https://github.com/mrfatboy/homebridge-snapshot-sensors.git"},
  "bugs": {"url": "https://github.com/mrfatboy/homebridge-snapshot-sensors/issues"},
  "homepage": "https://github.com/mrfatboy/homebridge-snapshot-sensors#readme",
  "license": "AGPL-3.0-only",
  "engines": {"node": ">=20.0.0", "homebridge": "^1.8.0 || ^2.0.0"},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "homebridge": "^2.0.0",
    "prettier": "^3.8.3",
    "typescript": "^5.0.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {"@homebridge/plugin-ui-utils": "^2.2.5"}
}
