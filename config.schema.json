{
  "pluginAlias": "StreamSensors",
  "pluginType": "platform",
  "singular": false,
  "schema": {
    "type": "object",
    "properties": {
      "streams": {
        "title": "Streams",
        "type": "array",
        "items": {
          "title": "Stream",
          "type": "object",
          "properties": {
            "name": {
              "title": "Stream Name",
              "type": "string",
              "required": true,
              "description": "Used as a prefix for every sensor, e.g. \"Garden\" → \"Garden Animals\""
            },
            "url": {
              "title": "Stream URL",
              "type": "string",
              "required": true,
              "format": "uri",
              "description": "RTSP stream URL, e.g. rtsp://camera-host:8554/ch2"
            },
            "sensors": {
              "title": "Sensors",
              "type": "array",
              "description": "Each entry becomes one HomeKit motion sensor. It triggers when any of its listed categories are detected.",
              "items": {
                "title": "Sensor",
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "title": "Category",
                  "type": "string",
                  "enum": ["animals", "packages", "people", "vehicles"]
                }
              }
            }
          }
        }
      }
    }
  }
}
